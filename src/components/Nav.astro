---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
];
---

<nav>
  <div class="nav-inner">
    <a href="/" class="logo">
      <span class="prompt">bryan@ward</span>
    </a>
    <button class="nav-toggle" aria-label="Toggle navigation menu" data-toggle>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
    <ul class="nav-links" data-nav>
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'nav-link',
              {
                active: currentPath === href || (href !== '/' && currentPath.startsWith(href + '/')),
              },
            ]}
          >
            {label}
          </a>
        </li>
      ))}
      <li class="nav-terminal-item">
        <button class="nav-terminal-btn" data-terminal-toggle aria-label="Toggle terminal">
          <span class="terminal-icon">&gt;_</span>
          Terminal
        </button>
      </li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.querySelector('[data-toggle]');
  const nav = document.querySelector('[data-nav]');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      nav.classList.toggle('nav-open');
      toggle.classList.toggle('nav-toggle-active');
    });
  }

  const termBtn = document.querySelector('[data-terminal-toggle]');
  if (termBtn) {
    termBtn.addEventListener('click', () => {
      document.body.classList.toggle('show-mobile-terminal');
      termBtn.classList.toggle('active');
    });
  }
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(5, 0, 10, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 2rem;
  }

  .logo {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--accent);
    text-decoration: none;
    cursor: pointer;
  }

  .logo:hover {
    text-shadow: 0 0 8px var(--accent-glow);
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s, text-shadow 0.2s;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
    text-shadow: 0 0 6px var(--accent-glow);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle-bar {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-muted);
    border-radius: 1px;
    transition: background 0.2s;
  }

  .nav-toggle:hover .nav-toggle-bar {
    background: var(--text);
  }

  .nav-terminal-item {
    display: none;
  }

  .nav-terminal-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 2rem;
    background: none;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .nav-terminal-btn:hover {
    color: var(--text);
    background: var(--surface);
  }

  .nav-terminal-btn.active {
    color: var(--accent);
    background: var(--surface);
  }

  .terminal-icon {
    color: var(--accent);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .nav-terminal-item {
      display: block;
      border-top: 1px solid var(--border);
      margin-top: 0.25rem;
      padding-top: 0.25rem;
    }
  }

  @media (max-width: 640px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgba(5, 0, 10, 0.95);
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 0;
    }

    .nav-links.nav-open {
      display: flex;
    }

    .nav-links li {
      width: 100%;
    }

    .nav-link {
      display: block;
      padding: 0.75rem 2rem;
      border-bottom: none;
    }

    .nav-link.active {
      border-bottom: none;
      background: var(--surface);
    }
  }
</style>
