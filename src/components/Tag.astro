---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span>{label}</span>

<style>
  span {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    background: rgba(0, 255, 102, 0.08);
    border: 1px solid rgba(0, 255, 102, 0.2);
    border-radius: 9999px;
    padding: 0.125em 0.5em;
    white-space: nowrap;
  }
</style>
