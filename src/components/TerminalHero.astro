    margin-bottom: 1.5rem;
    white-space: pre;
    text-shadow: 0 0 4px var(--accent-glow);
  }

  .info-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
  }

  .info-table td {
    padding: 0.375rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
