    text-shadow: 0 0 4px var(--accent-glow);
  }

  .prompt-line {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
  }

  .prompt-symbol {
    color: var(--accent);
    margin-right: 0.5rem;
  }

  .typed-text {
    color: var(--text);
  }

  .cursor.blink {
