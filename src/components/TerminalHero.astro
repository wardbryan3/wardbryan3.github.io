<style>
  .terminal-hero {
    max-width: 720px;
    margin: 3rem auto;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .terminal-header {
    display: flex;
