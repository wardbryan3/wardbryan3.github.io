---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const latestPost = sortedPosts[0];
const { Content } = await latestPost.render();

const allProjects = await getCollection('projects');
const searchData = [
  ...sortedPosts.map(p => ({ title: p.data.title, slug: p.slug, path: `/blog/${p.slug}`, type: 'blog', tags: p.data.tags, date: p.data.date })),
  ...allProjects.map(p => ({ title: p.data.title, slug: p.slug, path: `/projects/${p.slug}`, type: 'projects', tags: p.data.tags, date: p.data.date })),
];
const dirs = [{ name: 'blog', description: 'blog posts', count: sortedPosts.length }, { name: 'projects', description: 'projects', count: allProjects.length }];

const currentIndex = sortedPosts.findIndex((p) => p.slug === latestPost.slug);
const prevPost = currentIndex < sortedPosts.length - 1
  ? { title: sortedPosts[currentIndex + 1].data.title, slug: sortedPosts[currentIndex + 1].slug }
  : null;
const nextPost = currentIndex > 0
  ? { title: sortedPosts[currentIndex - 1].data.title, slug: sortedPosts[currentIndex - 1].slug }
  : null;
---

<BlogPost
  title={latestPost.data.title}
  description={latestPost.data.description}
  date={latestPost.data.date}
  tags={latestPost.data.tags}
  showTerminal={true}
  terminalPage="/blog"
  postCount={sortedPosts.length}
  searchData={searchData}
  dirs={dirs}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogPost>
