---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readTime = Math.max(1, Math.round(wordCount / 200));

const allPosts = await getCollection('blog');
const allProjects = await getCollection('projects');
const searchData = [
  ...allPosts.map(p => ({ title: p.data.title, slug: p.slug, path: `/blog/${p.slug}`, type: 'blog', tags: p.data.tags, date: p.data.date })),
  ...allProjects.map(p => ({ title: p.data.title, slug: p.slug, path: `/projects/${p.slug}`, type: 'projects', tags: p.data.tags, date: p.data.date })),
];
const dirs = [{ name: 'blog', description: 'blog posts', count: allPosts.length }, { name: 'projects', description: 'projects', count: allProjects.length }];
const sortedAllPosts = [...allPosts].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const currentIndex = sortedAllPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < sortedAllPosts.length - 1
  ? { title: sortedAllPosts[currentIndex + 1].data.title, slug: sortedAllPosts[currentIndex + 1].slug }
  : null;
const nextPost = currentIndex > 0
  ? { title: sortedAllPosts[currentIndex - 1].data.title, slug: sortedAllPosts[currentIndex - 1].slug }
  : null;
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  tags={post.data.tags}
  readTime={readTime}
  showTerminal={true}
  terminalPage={`/blog/${post.slug}`}
  postCount={allPosts.length}
  searchData={searchData}
  dirs={dirs}
  headings={headings}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogPost>
