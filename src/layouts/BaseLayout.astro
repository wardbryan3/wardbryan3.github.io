---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Terminal from '../terminal/Terminal';
import ErrorBoundary from '../components/ErrorBoundary';
import BootScreen from '../components/BootScreen.astro';
import MobileShell from '../components/mobile/MobileShell.jsx';
import '../styles/themes.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  showTerminal?: boolean;
  renderTerminal?: boolean;
  showBootScreen?: boolean;
  showMobileShell?: boolean;
  terminalPage?: string;
  projectCount?: number;
  postCount?: number;
  searchData?: any[];
  dirs?: { name: string; description: string; count: number }[];
}

const {
  title,
  description,
  image,
  showTerminal = false,
  renderTerminal = true,
  showBootScreen = false,
  showMobileShell = true,
  terminalPage = '/home',
  projectCount = 0,
  postCount = 0,
  searchData = [],
  dirs = [],
} = Astro.props;
const fullTitle = `${title} | Bryan Ward`;
const siteUrl = 'https://wardbryan3.github.io';
const ogImage = image || `${siteUrl}/og-default.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || "Bryan Ward - CS student and developer"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description || "Bryan Ward - CS student and developer"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description || "Bryan Ward - CS student and developer"} />
    <meta name="twitter:image" content={ogImage} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Bryan Ward's Blog" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        try {
          var saved = JSON.parse(localStorage.getItem('portfolio-os-settings'));
          if (saved) {
            if (saved.theme) document.documentElement.setAttribute('data-theme', saved.theme);
            if (saved.fontSize) {
              var mult = saved.fontSize === 'medium' ? 1.2 : saved.fontSize === 'large' ? 1.4 : 1;
              document.documentElement.style.setProperty('--os-font-mult', String(mult));
            }
          }
        } catch (e) { console.warn('[BaseLayout] Failed to apply saved settings:', e); }
      })();
    </script>
  </head>
  <body>
    {showBootScreen ? (
      <BootScreen>
        <Nav />
        <main class:list={{ 'has-mobile-shell': showMobileShell }}>
          <slot />
        </main>
        <Footer />
      </BootScreen>
    ) : (
      <>
        <Nav />
        <main class:list={{ 'has-mobile-shell': showMobileShell }}>
          <slot />
        </main>
        <Footer />
      </>
    )}
    {showMobileShell && <MobileShell currentPath={Astro.url.pathname} projectCount={projectCount} postCount={postCount} searchData={searchData} dirs={dirs} client:load />}
    {showTerminal && renderTerminal && (
      <ErrorBoundary>
        <Terminal
          page={terminalPage}
          projectCount={projectCount}
          postCount={postCount}
          searchData={searchData}
          dirs={dirs}
          side={true}
          defaultOpen={false}
          client:load
        />
      </ErrorBoundary>
    )}
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    main.has-mobile-shell {
      padding-bottom: 72px;
    }
  }
</style>
