---
import BaseLayout from './BaseLayout.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import TableOfContents from '../components/TableOfContents.jsx';
import Terminal from '../terminal/Terminal';
import Tag from '../components/Tag.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  readTime?: number;
  terminalPage?: string;
  postCount?: number;
  searchData?: any[];
  dirs?: { name: string; description: string; count: number }[];
  headings?: { depth: number; slug: string; text: string }[];
  prevPost?: { title: string; slug: string } | null;
  nextPost?: { title: string; slug: string } | null;
}

const {
  title,
  description,
  date,
  tags,
  readTime,
  terminalPage = '',
  postCount = 0,
  searchData = [],
  dirs = [],
  headings = [],
  prevPost = null,
  nextPost = null,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  showTerminal={false}
  renderTerminal={false}
  terminalPage={terminalPage}
  postCount={postCount}
  searchData={searchData}
>
  <div class="blog-docs-layout">
    <div class="blog-sidebar-column">
      <BlogSidebar />
    </div>
    <article class="blog-content">
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-header-meta">
          <time class="post-date" datetime={date.toISOString()}>
            {date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {readTime && (
            <span class="post-read-time">{readTime} min read</span>
          )}
        </div>
        {tags && tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => <Tag label={tag} />)}
          </div>
        )}
      </header>
      <div class="prose">
        <slot />
      </div>
      {(prevPost || nextPost) && (
        <nav class="post-nav">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}`} class="post-nav-link post-nav-prev">
              <span class="post-nav-direction">Previous</span>
              <span class="post-nav-title">{prevPost.title}</span>
            </a>
          ) : <div />}
          {nextPost ? (
            <a href={`/blog/${nextPost.slug}`} class="post-nav-link post-nav-next">
              <span class="post-nav-direction">Next</span>
              <span class="post-nav-title">{nextPost.title}</span>
            </a>
          ) : <div />}
        </nav>
      )}
    </article>
    {headings.length > 0 && (
      <div class="toc-column">
        <TableOfContents headings={headings} client:load />
      </div>
    )}
    <Terminal
      page={terminalPage || '/blog'}
      projectCount={0}
      postCount={postCount}
      searchData={searchData}
      dirs={dirs}
      flow={true}
      defaultOpen={false}
      client:only="react"
    />
  </div>
  <div id="reading-progress" class="reading-progress" />
</BaseLayout>

<script>
  const bar = document.getElementById('reading-progress');
  if (bar) {
    document.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
      bar.style.transform = `scaleX(${pct})`;
    }, { passive: true });
  }
</script>

<style>
  .blog-docs-layout {
    display: grid;
    grid-template-columns: 200px 1fr auto auto;
    min-height: calc(100vh - 48px - 58px);
    max-width: 100%;
  }

  .blog-content {
    padding: 2rem 2.5rem;
    max-width: 720px;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .post-header h1 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .post-header-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .post-read-time {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    opacity: 0.7;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .prose {
    line-height: 1.9;
    font-size: 1rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
  }

  .prose :global(h2) {
    font-size: 1.35rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 60px;
  }

  .prose :global(h3) {
    font-size: 1.1rem;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 60px;
  }

  .prose :global(h4) {
    scroll-margin-top: 60px;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.35rem;
  }

  .prose strong {
    color: var(--text);
  }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent-glow);
  }

  .prose a:hover {
    text-shadow: 0 0 8px var(--accent-glow);
  }

  .prose blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .prose code {
    font-size: 0.85em;
  }

  .prose pre {
    margin: 1.5rem 0;
  }

  .prose img {
    max-width: 100%;
    border-radius: 6px;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .toc-column {
    width: 200px;
    min-width: 200px;
    border-left: 1px solid var(--border);
    position: sticky;
    top: 52px;
    align-self: start;
    max-height: calc(100vh - 52px - 54px);
    overflow-y: auto;
  }

  @media (max-width: 1024px) {
    .blog-docs-layout {
      grid-template-columns: 200px 1fr;
    }
    .toc-column {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .blog-docs-layout {
      display: flex;
      flex-direction: column;
    }
    .blog-sidebar-column {
      display: none;
    }
    .blog-content {
      padding: 1.5rem 1rem;
      max-width: 100%;
    }
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    max-width: 50%;
  }

  .post-nav-next {
    text-align: right;
    align-items: flex-end;
  }

  .post-nav-prev {
    text-align: left;
    align-items: flex-start;
  }

  .post-nav-direction {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .post-nav-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    transition: text-shadow 0.2s;
  }

  .post-nav-link:hover .post-nav-title {
    text-shadow: 0 0 8px var(--accent-glow);
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(0);
    z-index: 10001;
    box-shadow: 0 0 6px var(--accent-glow);
  }

</style>

<style is:global>
  @media (max-width: 768px) {
    body {
      height: auto !important;
      overflow: visible !important;
    }
    main {
      flex: none !important;
      overflow: visible !important;
      min-height: 0 !important;
    }
  }
</style>
